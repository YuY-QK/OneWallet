# 密钥与本地配置：永不提交
.env
.env.*
*.keystore
*.jks
*.p12
*.mobileprovision
key.properties
*.owbak
*.owv
# 例外：备份格式的测试样本（只含公开测试向量与假数据，见该目录的 README_backup.md）
!packages/ow_vault/test/fixtures/*.owbak

# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.g.dart
# ow_data 的 Drift 生成代码强制入库（CI 不运行 build_runner）
!packages/ow_data/lib/**/*.g.dart
!packages/ow_directory/lib/**/*.g.dart
*.freezed.dart
coverage/

# IDE 与系统
.idea/
.vscode/
*.iml
.DS_Store

# iOS / Android 构建产物
**/ios/Pods/
**/ios/.symlinks/
**/android/.gradle/
**/android/local.properties

# 并行任务的临时工作副本
.claude/worktrees/
